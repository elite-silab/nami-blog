{
  "name": "nami-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nami 娜美 CF 博客 — Next.js + Hono 单 Cloudflare Worker 博客",
  "repository": {
    "type": "git",
    "url": "https://github.com/elite-silab/nami-blog.git"
  },
  "homepage": "https://github.com/elite-silab/nami-blog#readme",
  "bugs": {
    "url": "https://github.com/elite-silab/nami-blog/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "predev": "pnpm db:migrate",
    "dev": "pnpm --filter @nami/web dev",
    "build": "pnpm --filter @nami/web build",
    "build:worker": "pnpm --filter @nami/web build:worker",
    "preview": "pnpm build:worker && wrangler dev --config wrangler.jsonc",
    "deploy": "pnpm --filter @nami/web deploy:full",
    "lint": "pnpm -r lint",
    "check": "pnpm -r typecheck && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @nami/api test:watch",
    "db:migrate": "pnpm --filter @nami/api db:migrate",
    "db:seed": "pnpm --filter @nami/api db:seed",
    "db:reset": "pnpm --filter @nami/api db:reset",
    "db:migrate:prod": "wrangler d1 migrations apply nami-blog --remote --config wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
