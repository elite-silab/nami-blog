---
/**
 * Nami Blog Logo 图标组件（正方形，适合 Sidebar/Favicon）
 * 内联 SVG，颜色跟随主题变化
 * Props: size (number, px)
 */

interface Props {
  size?: number;
}

const { size = 32 } = Astro.props as Props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  aria-label="Nami"
  role="img"
>
  <!-- 圆角矩形背景 -->
  <rect x="2" y="2" width="44" height="44" rx="12" fill="var(--color-primary)"/>

  <!-- N 字母 -->
  <path d="M14 36 L14 12 L34 36 L34 12" stroke="white" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- 花瓣点缀 -->
  <circle cx="8" cy="8" r="2.5" fill="white" opacity="0.5"/>
  <circle cx="14" cy="5" r="1.5" fill="white" opacity="0.4"/>
  <circle cx="5" cy="14" r="1.5" fill="white" opacity="0.3"/>

  <!-- 底部波浪 -->
  <path d="M8 40 Q15 36 22 40 Q29 44 36 40" stroke="white" stroke-width="1.5" fill="none" opacity="0.35" stroke-linecap="round"/>
</svg>
