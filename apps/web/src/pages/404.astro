---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 — 页面未找到">
  <section class="mx-auto flex max-w-md flex-col items-center px-4 py-24 text-center">
    <p class="text-8xl font-bold text-[var(--color-primary)]">404</p>
    <h1 class="mt-4 text-2xl font-bold">页面走丢了</h1>
    <p class="mt-2 text-[var(--color-text-secondary)]">
      你访问的页面不存在，可能已被移动或删除。
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-[var(--color-primary)] px-6 py-3 text-white hover:bg-[var(--color-primary-hover)]"
    >
      返回首页
    </a>
  </section>
</BaseLayout>
