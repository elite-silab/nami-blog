---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="站点设置">
  <div id="settings-root" class="py-8 text-center text-sm text-[var(--color-text-tertiary)]">加载中…</div>

  <script>
    import { THEMES, DEFAULT_THEME, type ThemeId } from "@/lib/theme";
    import {
      ADMIN_API_BASE as API_BASE,
      adminFetch,
      clearAdminSession,
    } from "@/lib/admin-session";
    import { getPagesDeployNotice } from "@/lib/pages-deployment";

    let selectedTheme: ThemeId = DEFAULT_THEME;
    let isDarkMode = false;

    function esc(s: string) { const d = document.createElement("div"); d.textContent = s; return d.innerHTML; }

    async function loadSettings() {
      const root = document.getElementById("settings-root")!;
      try {
        const res = await adminFetch(`${API_BASE}/api/admin/settings`);
        if (res.status === 401) { window.location.href = "/admin/login"; return; }
        const { data } = await res.json();
        const s = data || {};

        const siteName = s.site_name || "Nami Blog";
        const siteSubtitle = s.site_subtitle || "记录技术与生活";
        const seoDescription = s.seo_description || "";
        const socialLinks = s.social_links || {};
        selectedTheme = (s.site_theme || DEFAULT_THEME) as ThemeId;
        isDarkMode = document.documentElement.getAttribute("data-dark") === "true";
        const commentEnabled = s.comment_enabled === true || s.comment_enabled === "true";
        const commentAutoApprove = s.comment_auto_approve === true || s.comment_auto_approve === "true";
        const sensitiveWords = Array.isArray(s.sensitive_words) ? s.sensitive_words : [];

        const darkSwitchBg = isDarkMode ? "bg-[var(--color-primary)]" : "bg-[var(--color-bg-tertiary)] border border-[var(--color-border)]";
        const darkSwitchDot = isDarkMode ? "translate-x-6" : "translate-x-1";

        root.innerHTML = `
          <form id="settings-form" class="max-w-2xl space-y-8">
            <section>
              <h2 class="mb-4 text-lg font-semibold">基础设置</h2>
              <div class="space-y-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
                <div><label class="block text-sm font-medium">站点名称</label><input type="text" name="site_name" value="${esc(siteName)}" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /></div>
                <div><label class="block text-sm font-medium">副标题</label><input type="text" name="site_subtitle" value="${esc(siteSubtitle)}" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /></div>
              </div>
            </section>
            <section>
              <h2 class="mb-4 text-lg font-semibold">SEO</h2>
              <div class="space-y-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
                <div><label class="block text-sm font-medium">默认 Meta Description</label><textarea name="seo_description" rows="3" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm">${esc(seoDescription)}</textarea></div>
              </div>
            </section>
            <section>
              <h2 class="mb-4 text-lg font-semibold">社交链接</h2>
              <div class="space-y-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
                <div><label class="block text-sm font-medium">GitHub</label><input type="url" name="social_github" value="${esc(socialLinks.github || "")}" placeholder="https://github.com/username" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /></div>
                <div><label class="block text-sm font-medium">Twitter / X</label><input type="url" name="social_twitter" value="${esc(socialLinks.twitter || "")}" placeholder="https://x.com/username" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /></div>
                <div><label class="block text-sm font-medium">邮箱</label><input type="email" name="social_email" value="${esc(socialLinks.email || "")}" placeholder="you@example.com" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /></div>
              </div>
            </section>
            <section>
              <h2 class="mb-4 text-lg font-semibold">主题外观</h2>
              <div class="mb-4 flex items-center justify-between">
                <p class="text-sm text-[var(--color-text-secondary)]">选择一套二次元风格主题，点击即时预览，确认后保存。</p>
                <label class="flex cursor-pointer items-center gap-2">
                  <span class="text-sm text-[var(--color-text-secondary)]">Dark 模式</span>
                  <div id="dark-mode-switch" role="button" tabindex="0" class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${darkSwitchBg}">
                    <div class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-sm ${darkSwitchDot}"></div>
                  </div>
                </label>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3" id="theme-picker">
                ${THEMES.map(t => {
                  const c = isDarkMode ? t.darkColors : t.colors;
                  return `
                  <button type="button" data-theme-id="${t.id}" class="group relative flex flex-col overflow-hidden rounded-xl border-2 transition-all ${selectedTheme === t.id ? "border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/30" : "border-[var(--color-border)] hover:border-[var(--color-border-strong)]"}">
                    <div class="flex h-28 flex-col justify-between p-4" style="background: ${c.bg}">
                      <div class="flex items-center gap-2"><div class="h-3 w-3 rounded-full" style="background: ${c.primary}"></div><div class="h-3 w-3 rounded-full" style="background: ${c.accent}"></div><div class="ml-auto h-2 w-12 rounded-full" style="background: ${c.primary}; opacity: 0.4"></div></div>
                      <div><div class="mb-1 h-2 w-20 rounded-full" style="background: ${c.text}; opacity: 0.7"></div><div class="h-2 w-14 rounded-full" style="background: ${c.text}; opacity: 0.3"></div></div>
                    </div>
                    <div class="flex items-center justify-between border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)] px-4 py-3">
                      <div class="text-left"><span class="text-sm font-medium">${t.emoji} ${t.name}</span><p class="text-xs text-[var(--color-text-tertiary)]">${t.description}</p></div>
                      ${selectedTheme === t.id ? '<span class="theme-check flex h-5 w-5 items-center justify-center rounded-full bg-[var(--color-primary)] text-xs text-white">✓</span>' : ""}
                    </div>
                  </button>
                `}).join("")}
              </div>
              <div id="theme-status" class="mt-3 text-sm text-[var(--color-text-secondary)]"></div>
            </section>
            <section>
              <h2 class="mb-4 text-lg font-semibold">评论</h2>
              <div class="space-y-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
                <label class="flex items-center gap-3"><input type="checkbox" name="comment_enabled" ${commentEnabled ? "checked" : ""} /><span class="text-sm font-medium">启用评论</span></label>
                <label class="flex items-center gap-3"><input type="checkbox" name="comment_auto_approve" ${commentAutoApprove ? "checked" : ""} /><span class="text-sm font-medium">自动批准评论</span></label>
                <div><label class="block text-sm font-medium">敏感词列表（每行一个）</label><textarea name="sensitive_words" rows="4" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 font-mono text-sm">${sensitiveWords.join("\n")}</textarea></div>
              </div>
            </section>
            <section>
              <h2 class="mb-4 text-lg font-semibold">修改密码</h2>
              <div id="password-form-wrap" class="space-y-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
                <div><label class="block text-sm font-medium">当前密码</label><input type="password" name="old_password" autocomplete="current-password" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /></div>
                <div><label class="block text-sm font-medium">新密码</label><input type="password" name="new_password" minlength="8" autocomplete="new-password" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /><p class="mt-1 text-xs text-[var(--color-text-tertiary)]">至少 8 个字符</p></div>
                <div><label class="block text-sm font-medium">确认新密码</label><input type="password" name="confirm_password" minlength="8" autocomplete="new-password" class="mt-1 w-full rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm" /></div>
                <div class="flex items-center gap-4">
                  <button type="button" id="btn-change-pw" class="rounded-lg border border-[var(--color-border)] px-4 py-2 text-sm font-medium hover:bg-[var(--color-bg-tertiary)]">修改密码</button>
                  <span id="password-status" class="text-sm text-[var(--color-text-secondary)]"></span>
                </div>
              </div>
            </section>
            <div class="flex items-center justify-between">
              <div id="save-status" class="text-sm text-[var(--color-text-secondary)]"></div>
              <button type="submit" class="rounded-lg bg-[var(--color-primary)] px-6 py-2 text-sm font-medium text-white hover:bg-[var(--color-primary-hover)]">保存设置</button>
            </div>
          </form>
        `;

        bindEvents();
      } catch {
        root.innerHTML = '<div class="py-8 text-center text-sm text-[var(--color-danger)]">加载失败</div>';
      }
    }

    function bindEvents() {
      const form = document.getElementById("settings-form") as HTMLFormElement;
      const statusEl = document.getElementById("save-status") as HTMLDivElement;

      // 修改密码
      document.getElementById("btn-change-pw")?.addEventListener("click", async () => {
        const wrap = document.getElementById("password-form-wrap")!;
        const pwStatus = document.getElementById("password-status") as HTMLSpanElement;
        const inputs = wrap.querySelectorAll<HTMLInputElement>("input[type=password]");
        const oldPw = inputs[0]?.value;
        const newPw = inputs[1]?.value;
        const confirmPw = inputs[2]?.value;
        if (newPw !== confirmPw) { pwStatus.textContent = "两次密码不一致"; pwStatus.style.color = "var(--color-danger)"; return; }
        pwStatus.textContent = "修改中...";
        try {
          const res = await adminFetch(`${API_BASE}/api/v1/auth/change-password`, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ oldPassword: oldPw, newPassword: newPw }),
          });
          const data = await res.json();
          if (res.ok) {
            clearAdminSession();
            pwStatus.textContent = "✓ 密码已修改，请重新登录";
            pwStatus.style.color = "var(--color-success)";
            inputs.forEach(i => i.value = "");
            setTimeout(() => { window.location.href = "/admin/login"; }, 1200);
          }
          else { pwStatus.textContent = data.error?.message || "修改失败"; pwStatus.style.color = "var(--color-danger)"; }
        } catch { pwStatus.textContent = "网络错误"; pwStatus.style.color = "var(--color-danger)"; }
        setTimeout(() => { pwStatus.textContent = ""; }, 5000);
      });

      // Dark mode switch
      const darkSwitch = document.getElementById("dark-mode-switch");
      darkSwitch?.addEventListener("click", () => {
        isDarkMode = !isDarkMode;
        const html = document.documentElement;
        if (isDarkMode) {
          html.setAttribute("data-dark", "true");
          localStorage.setItem("nami-dark", "true");
        } else {
          html.removeAttribute("data-dark");
          localStorage.setItem("nami-dark", "false");
        }
        // Update switch appearance
        darkSwitch.className = "relative inline-flex h-6 w-11 items-center rounded-full transition-colors " + (isDarkMode ? "bg-[var(--color-primary)]" : "bg-[var(--color-bg-tertiary)] border border-[var(--color-border)]");
        const dot = darkSwitch.querySelector("div")!;
        dot.className = "inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-sm " + (isDarkMode ? "translate-x-6" : "translate-x-1");
        // Update admin header dark icon
        const headerDarkBtn = document.querySelector<HTMLElement>("#dark-toggle");
        if (headerDarkBtn) headerDarkBtn.textContent = isDarkMode ? "☀️" : "🌙";
        // Refresh theme picker previews
        refreshThemePreviews();
      });

      function refreshThemePreviews() {
        const picker = document.getElementById("theme-picker");
        if (!picker) return;
        picker.querySelectorAll<HTMLButtonElement>("[data-theme-id]").forEach(btn => {
          const themeId = btn.dataset.themeId as ThemeId;
          const meta = THEMES.find(t => t.id === themeId);
          if (!meta) return;
          const c = isDarkMode ? meta.darkColors : meta.colors;
          const preview = btn.querySelector<HTMLElement>(".flex.h-28");
          if (preview) {
            preview.style.background = c.bg;
            const dots = preview.querySelectorAll<HTMLElement>(".h-3.w-3");
            if (dots[0]) dots[0].style.background = c.primary;
            if (dots[1]) dots[1].style.background = c.accent;
            const bar = preview.querySelector<HTMLElement>(".h-2.w-12");
            if (bar) bar.style.background = c.primary;
            const lines = preview.querySelectorAll<HTMLElement>(".h-2.w-20, .h-2.w-14");
            if (lines[0]) lines[0].style.background = c.text;
            if (lines[1]) lines[1].style.background = c.text;
          }
        });
      }

      // 主题切换
      const themePicker = document.getElementById("theme-picker");
      const themeStatus = document.getElementById("theme-status");
      themePicker?.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-theme-id]");
        if (!btn) return;
        const themeId = btn.dataset.themeId as ThemeId;
        selectedTheme = themeId;
        document.documentElement.setAttribute("data-theme", themeId);
        localStorage.setItem("nami-theme", themeId);
        // Update header dark icon
        const headerDarkBtn2 = document.querySelector<HTMLElement>("#dark-toggle");
        if (headerDarkBtn2) headerDarkBtn2.textContent = isDarkMode ? "☀️" : "🌙";
        themePicker.querySelectorAll<HTMLButtonElement>("[data-theme-id]").forEach((b) => {
          const isSelected = b.dataset.themeId === themeId;
          b.classList.toggle("border-[var(--color-primary)]", isSelected);
          b.classList.toggle("ring-2", isSelected);
          b.classList.toggle("ring-[var(--color-primary)]/30", isSelected);
          b.classList.toggle("border-[var(--color-border)]", !isSelected);
          const existingCheck = b.querySelector(".theme-check");
          if (isSelected && !existingCheck) {
            const span = document.createElement("span");
            span.className = "theme-check flex h-5 w-5 items-center justify-center rounded-full bg-[var(--color-primary)] text-xs text-white";
            span.textContent = "✓";
            b.querySelector(".flex.items-center.justify-between")?.appendChild(span);
          } else if (!isSelected && existingCheck) { existingCheck.remove(); }
        });
        if (themeStatus) {
          themeStatus.textContent = "主题预览中，点击下方「保存设置」后更新前台。";
        }
      });

      // 保存设置
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        statusEl.textContent = "保存中...";
        const fd = new FormData(form);
        const data: Record<string, unknown> = {
          site_name: fd.get("site_name"),
          site_subtitle: fd.get("site_subtitle"),
          seo_description: fd.get("seo_description"),
          social_links: { github: fd.get("social_github") || null, twitter: fd.get("social_twitter") || null, email: fd.get("social_email") || null },
          site_theme: selectedTheme,
          comment_enabled: (form.querySelector("[name=comment_enabled]") as HTMLInputElement)?.checked,
          comment_auto_approve: (form.querySelector("[name=comment_auto_approve]") as HTMLInputElement)?.checked,
          sensitive_words: (fd.get("sensitive_words") as string).split("\n").filter((w) => w.trim()),
        };
        try {
          const res = await adminFetch(`${API_BASE}/api/admin/settings`, {
            method: "PUT", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (res.ok) {
            const deployNotice = getPagesDeployNotice(result.data?.deployment?.status);
            statusEl.textContent = deployNotice?.message || "已保存";
            statusEl.style.color = deployNotice?.kind === "error"
              ? "var(--color-danger)"
              : deployNotice?.kind === "warning"
                ? "var(--color-warning)"
                : "var(--color-success)";
          }
          else { statusEl.textContent = "保存失败"; statusEl.style.color = "var(--color-danger)"; }
        } catch { statusEl.textContent = "保存失败"; statusEl.style.color = "var(--color-danger)"; }
      });
    }

    loadSettings();
  </script>
</AdminLayout>
