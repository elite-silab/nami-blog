---
import "@/styles/global.css";
import { THEME_INIT_SCRIPT } from "@/lib/theme";
import Logo from "@/components/Logo.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登录 — Nami Blog Admin</title>
    <script is:inline set:html={THEME_INIT_SCRIPT} />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-[var(--color-bg-secondary)] antialiased">
    <div class="w-full max-w-sm px-4">
      <!-- Logo -->
      <div class="mb-8 flex flex-col items-center">
        <Logo size="lg" />
        <p class="mt-2 text-sm text-[var(--color-text-secondary)]">管理后台登录</p>
      </div>

      <!-- Login Form -->
      <form id="login-form" class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
        {import.meta.env.DEV && (
          <div class="mb-5 rounded-lg border border-[var(--color-primary)]/25 bg-[var(--color-primary-light)] p-3 text-sm leading-6 text-[var(--color-text-secondary)]">
            <p class="font-medium text-[var(--color-text)]">本地首次登录</p>
            <p>用户名为 <code>admin</code>，密码请查看根目录 <code>.env</code> 中的 <code>ADMIN_INITIAL_PASSWORD</code>。</p>
          </div>
        )}
        <div class="space-y-4">
          <div>
            <label for="username" class="block text-sm font-medium">用户名</label>
            <input
              type="text"
              id="username"
              name="username"
              value={import.meta.env.DEV ? "admin" : undefined}
              required
              autocomplete="username"
              class="mt-1 block w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-sm focus:border-[var(--color-primary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)]"
              placeholder="admin"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium">密码</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="mt-1 block w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-sm focus:border-[var(--color-primary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)]"
              placeholder="••••••••"
            />
          </div>

          <!-- Error message -->
          <div id="error-msg" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400"></div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full rounded-lg bg-[var(--color-primary)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--color-primary-hover)] disabled:opacity-50"
          >
            登录
          </button>
        </div>
      </form>

      <p class="mt-4 text-center text-xs text-[var(--color-text-tertiary)]">
        &larr; <a href="/" class="hover:text-[var(--color-text)]">返回前台</a>
      </p>
    </div>

    <script>
      import {
        ADMIN_API_BASE as API_BASE,
        adminFetch,
        saveAdminSession,
      } from "@/lib/admin-session";

      // 客户端检查：如果已登录，重定向到仪表盘
      adminFetch(`${API_BASE}/api/admin/dashboard`)
        .then(r => { if (r.ok) window.location.href = "/admin"; })
        .catch(() => {});

      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorMsg = document.getElementById("error-msg") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.classList.add("hidden");
        submitBtn.disabled = true;
        submitBtn.textContent = "登录中...";

        const formData = new FormData(form);
        const username = formData.get("username") as string;
        const password = formData.get("password") as string;

        try {
          const res = await fetch(`${API_BASE}/api/v1/auth/login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
            body: JSON.stringify({ username, password }),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error?.message || "登录失败");

          saveAdminSession(data.data);
          window.location.href = "/admin";
        } catch (err) {
          errorMsg.textContent = err instanceof Error ? err.message : "登录失败，请重试";
          errorMsg.classList.remove("hidden");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "登录";
        }
      });
    </script>
  </body>
</html>
