---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="文章管理">
  <div id="posts-root">
    <div class="flex items-center justify-between">
      <div id="filter-tabs" class="flex items-center gap-2"></div>
      <a href="/admin/posts/new" class="rounded-lg bg-[var(--color-primary)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--color-primary-hover)]">+ 新建文章</a>
    </div>
    <div id="posts-table" class="mt-4 py-8 text-center text-sm text-[var(--color-text-tertiary)]">加载中…</div>
    <div id="posts-pagination" class="mt-4"></div>
  </div>

  <script>
    import { ADMIN_API_BASE as API_BASE, adminFetch } from "@/lib/admin-session";
    const params = new URLSearchParams(window.location.search);
    const status = params.get("status") || "";
    const page = parseInt(params.get("page") || "1");

    const statusLabels: Record<string, string> = { published: "已发布", draft: "草稿", archived: "已归档" };
    const statusColors: Record<string, string> = { published: "bg-green-100 text-green-700", draft: "bg-yellow-100 text-yellow-700", archived: "bg-gray-100 text-gray-700" };

    function esc(s: string) { const d = document.createElement("div"); d.textContent = s; return d.innerHTML; }

    async function loadPosts() {
      const tabs = document.getElementById("filter-tabs")!;
      const table = document.getElementById("posts-table")!;
      const pagination = document.getElementById("posts-pagination")!;

      tabs.innerHTML = ["", "published", "draft"].map(s => {
        const label = s ? statusLabels[s] : "全部";
        const href = s ? `/admin/posts?status=${s}` : "/admin/posts";
        const active = s === status;
        return `<a href="${href}" class="rounded-lg px-3 py-1.5 text-sm ${active ? "bg-[var(--color-primary)] text-white" : "text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-tertiary)]"}">${label}</a>`;
      }).join("");

      try {
        const qs = new URLSearchParams();
        if (status) qs.set("status", status);
        qs.set("page", String(page));
        const res = await adminFetch(`${API_BASE}/api/admin/posts?${qs}`);
        if (res.status === 401) { window.location.href = "/admin/login"; return; }
        const { data, meta } = await res.json();
        const totalPages = Math.ceil(meta.total / meta.limit);

        if (data.length === 0) {
          table.innerHTML = `<div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] py-12 text-center"><div class="text-4xl">📝</div><div class="mt-2 text-[var(--color-text-tertiary)]">暂无文章</div></div>`;
          return;
        }

        table.innerHTML = `<div class="overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)]">
          <table class="w-full text-sm"><thead class="border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
            <tr><th class="px-4 py-3 text-left font-medium">标题</th><th class="px-4 py-3 text-left font-medium">状态</th><th class="px-4 py-3 text-left font-medium">浏览</th><th class="px-4 py-3 text-left font-medium">更新时间</th><th class="px-4 py-3 text-right font-medium">操作</th></tr>
          </thead><tbody class="divide-y divide-[var(--color-border)]">
            ${data.map((p: any) => `<tr class="hover:bg-[var(--color-bg-secondary)]">
              <td class="px-4 py-3"><div class="flex items-center gap-2">${p.is_pinned ? '<span class="text-xs text-[var(--color-warning)]">📌</span>' : ""}<span class="font-medium">${esc(p.title)}</span></div></td>
              <td class="px-4 py-3"><span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium ${statusColors[p.status] || ""}">${statusLabels[p.status] || p.status}</span></td>
              <td class="px-4 py-3 text-[var(--color-text-secondary)]">${p.view_count}</td>
              <td class="px-4 py-3 text-[var(--color-text-secondary)]">${new Date(p.updated_at).toLocaleDateString("zh-CN")}</td>
              <td class="px-4 py-3 text-right"><div class="flex items-center justify-end gap-2"><a href="/admin/posts/edit?id=${p.id}" class="text-[var(--color-primary)] hover:underline">编辑</a><button data-delete-id="${p.id}" data-delete-title="${esc(p.title)}" class="text-[var(--color-danger)] hover:underline">删除</button></div></td>
            </tr>`).join("")}
          </tbody></table></div>`;

        if (totalPages > 1) {
          pagination.innerHTML = `<div class="flex items-center justify-between"><span class="text-sm text-[var(--color-text-secondary)]">共 ${meta.total} 篇，第 ${page}/${totalPages} 页</span><div class="flex gap-2">
            ${page > 1 ? `<a href="/admin/posts?page=${page - 1}${status ? `&status=${status}` : ""}" class="rounded-lg border border-[var(--color-border)] px-3 py-1.5 text-sm hover:bg-[var(--color-bg-tertiary)]">上一页</a>` : ""}
            ${page < totalPages ? `<a href="/admin/posts?page=${page + 1}${status ? `&status=${status}` : ""}" class="rounded-lg border border-[var(--color-border)] px-3 py-1.5 text-sm hover:bg-[var(--color-bg-tertiary)]">下一页</a>` : ""}
          </div></div>`;
        }
      } catch {
        table.innerHTML = '<div class="py-8 text-center text-[var(--color-danger)]">加载失败</div>';
      }
    }

    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;
      const deleteId = target.dataset.deleteId;
      const deleteTitle = target.dataset.deleteTitle;
      if (!deleteId) return;
      if (!confirm(`确认删除文章「${deleteTitle}」？`)) return;
      try {
        const res = await adminFetch(`${API_BASE}/api/admin/posts/${deleteId}`, { method: "DELETE" });
        if (res.ok) window.location.reload(); else alert("删除失败");
      } catch { alert("删除失败"); }
    });

    loadPosts();
  </script>
</AdminLayout>
