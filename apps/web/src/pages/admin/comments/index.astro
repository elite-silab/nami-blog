---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="评论管理">
  <div id="comments-root">
    <div id="tabs-nav" class="flex gap-2"></div>
    <div id="comments-list" class="mt-4 py-8 text-center text-sm text-[var(--color-text-tertiary)]">加载中…</div>
    <div id="comments-pagination" class="mt-4"></div>
  </div>

  <script>
    import { ADMIN_API_BASE as API_BASE, adminFetch } from "@/lib/admin-session";
    const params = new URLSearchParams(window.location.search);
    const tab = params.get("tab") || "all";
    const page = parseInt(params.get("page") || "1");

    const statusLabels: Record<string, string> = { pending: "待审核", approved: "已批准", rejected: "已拒绝" };
    const statusColors: Record<string, string> = { pending: "bg-yellow-100 text-yellow-700", approved: "bg-green-100 text-green-700", rejected: "bg-red-100 text-red-700" };

    function esc(s: string) { const d = document.createElement("div"); d.textContent = s; return d.innerHTML; }

    async function loadComments() {
      const nav = document.getElementById("tabs-nav")!;
      const list = document.getElementById("comments-list")!;
      const pagination = document.getElementById("comments-pagination")!;

      nav.innerHTML = ["all", "pending", "approved"].map(t => {
        const label = t === "all" ? "全部" : t === "pending" ? "待审核" : "已批准";
        const href = t === "all" ? "/admin/comments" : `/admin/comments?tab=${t}`;
        const active = t === tab;
        return `<a href="${href}" class="rounded-lg px-3 py-1.5 text-sm ${active ? "bg-[var(--color-primary)] text-white" : "text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-tertiary)]"}">${label}</a>`;
      }).join("");

      try {
        const qs = new URLSearchParams();
        if (tab !== "all") qs.set("status", tab);
        qs.set("page", String(page));
        const res = await adminFetch(`${API_BASE}/api/admin/comments?${qs}`);
        if (res.status === 401) { window.location.href = "/admin/login"; return; }
        const { data, meta } = await res.json();
        const totalPages = Math.ceil((meta?.total || 0) / (meta?.limit || 20));

        if (!data || data.length === 0) {
          list.innerHTML = `<div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] py-12 text-center"><div class="text-4xl">💬</div><div class="mt-2 text-[var(--color-text-tertiary)]">暂无评论</div></div>`;
          return;
        }

        list.innerHTML = `<div class="space-y-3">${data.map((c: any) => `
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-medium">${esc(c.author_name)}</span>
                  <span class="rounded-full px-2 py-0.5 text-xs ${statusColors[c.status] || ""}">${statusLabels[c.status] || c.status}</span>
                </div>
                ${c.author_email ? `<span class="text-xs text-[var(--color-text-tertiary)]">${esc(c.author_email)}</span>` : ""}
              </div>
              <span class="text-xs text-[var(--color-text-tertiary)]">${new Date(c.created_at).toLocaleString("zh-CN")}</span>
            </div>
            <p class="mt-2 text-sm">${esc(c.content)}</p>
            <div class="mt-2 flex items-center justify-between">
              <span class="text-xs text-[var(--color-text-tertiary)]">文章：<span class="text-[var(--color-primary)]">${esc(c.post_title || "")}</span></span>
              <div class="flex gap-2">
                ${c.status !== "approved" ? `<button data-action="approve" data-id="${c.id}" class="text-xs text-[var(--color-success)] hover:underline">批准</button>` : ""}
                ${c.status !== "rejected" ? `<button data-action="reject" data-id="${c.id}" class="text-xs text-[var(--color-warning)] hover:underline">拒绝</button>` : ""}
                <button data-action="delete" data-id="${c.id}" data-content="${esc(c.content.slice(0, 30))}" class="text-xs text-[var(--color-danger)] hover:underline">删除</button>
              </div>
            </div>
          </div>
        `).join("")}</div>`;

        if (totalPages > 1) {
          pagination.innerHTML = `<div class="flex items-center justify-between"><span class="text-sm text-[var(--color-text-secondary)]">共 ${meta.total} 条，第 ${page}/${totalPages} 页</span><div class="flex gap-2">
            ${page > 1 ? `<a href="/admin/comments?page=${page - 1}${tab !== "all" ? `&tab=${tab}` : ""}" class="rounded-lg border border-[var(--color-border)] px-3 py-1.5 text-sm hover:bg-[var(--color-bg-tertiary)]">上一页</a>` : ""}
            ${page < totalPages ? `<a href="/admin/comments?page=${page + 1}${tab !== "all" ? `&tab=${tab}` : ""}" class="rounded-lg border border-[var(--color-border)] px-3 py-1.5 text-sm hover:bg-[var(--color-bg-tertiary)]">下一页</a>` : ""}
          </div></div>`;
        }
      } catch {
        list.innerHTML = '<div class="py-8 text-center text-[var(--color-danger)]">加载失败</div>';
      }
    }

    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;
      const action = target.dataset.action;
      const id = target.dataset.id;
      if (!action || !id) return;

      if (action === "delete") {
        if (!confirm(`确认删除评论「${target.dataset.content}...」？`)) return;
      }

      const method = action === "delete" ? "DELETE" : "PATCH";
      const body = action !== "delete" ? JSON.stringify({ status: action === "approve" ? "approved" : "rejected" }) : undefined;
      const url = action !== "delete"
        ? `${API_BASE}/api/admin/comments/${id}/status`
        : `${API_BASE}/api/admin/comments/${id}`;

      try {
        const res = await adminFetch(url, { method, headers: { "Content-Type": "application/json" }, body });
        if (res.ok) location.reload();
        else alert("操作失败");
      } catch { alert("操作失败，请重试"); }
    });

    loadComments();
  </script>
</AdminLayout>
