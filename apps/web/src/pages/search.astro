---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="搜索 — Nami Blog">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-2xl font-bold">搜索文章</h1>

    <!-- 搜索框 -->
    <form id="search-form" class="mt-6 flex gap-2">
      <input
        type="text"
        id="search-input"
        aria-label="搜索关键词"
        placeholder="输入关键词搜索..."
        class="flex-1 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm focus:border-[var(--color-primary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)]"
      />
      <button
        id="search-btn"
        class="rounded-lg bg-[var(--color-primary)] px-6 py-3 text-sm font-medium text-white hover:bg-[var(--color-primary-hover)]"
      >
        搜索
      </button>
    </form>

    <!-- 搜索结果 -->
    <div id="search-results" class="mt-8" aria-live="polite" aria-busy="false"></div>
  </section>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8788";
    const input = document.getElementById("search-input") as HTMLInputElement;
    const btn = document.getElementById("search-btn") as HTMLButtonElement;
    const results = document.getElementById("search-results") as HTMLDivElement;
    const form = document.getElementById("search-form") as HTMLFormElement;
    let activeRequest = 0;

    function esc(s: string) {
      const d = document.createElement("div");
      d.textContent = s;
      return d.innerHTML;
    }

    // 从 URL 读取初始关键词
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get("q") || "";
    if (initialQ) {
      input.value = initialQ;
      doSearch(initialQ);
    }

    async function doSearch(q: string) {
      if (!q.trim()) {
        results.innerHTML = '<p class="text-center text-[var(--color-text-tertiary)]">请输入搜索关键词</p>';
        return;
      }

      // 更新 URL
      const url = new URL(window.location.href);
      url.searchParams.set("q", q);
      window.history.replaceState(null, "", url.toString());

      btn.disabled = true;
      btn.textContent = "搜索中...";
      results.setAttribute("aria-busy", "true");
      results.innerHTML = `<div class="space-y-3" aria-label="搜索加载中">
        <div class="h-28 animate-pulse rounded-2xl bg-[var(--color-bg-secondary)]"></div>
        <div class="h-28 animate-pulse rounded-2xl bg-[var(--color-bg-secondary)]"></div>
        <div class="h-28 animate-pulse rounded-2xl bg-[var(--color-bg-secondary)]"></div>
      </div>`;
      const requestId = ++activeRequest;

      try {
        const res = await fetch(`${API_BASE}/api/v1/posts?q=${encodeURIComponent(q)}&limit=50`);
        if (requestId !== activeRequest) return;
        if (!res.ok) throw new Error();
        const { data, meta } = await res.json();

        if (data.length === 0) {
          results.innerHTML = `<div class="py-12 text-center">
            <div class="text-4xl">🔍</div>
            <p class="mt-4 text-[var(--color-text-secondary)]">没有找到与「${esc(q)}」相关的文章</p>
          </div>`;
        } else {
          results.innerHTML = `<p class="mb-4 text-sm text-[var(--color-text-secondary)]">找到 ${meta.total} 篇相关文章</p>
            <div class="space-y-4">${data.map((post: any) => `
              <a href="/blog/${post.slug}" class="group block rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5 transition-all hover:border-[var(--color-primary)] hover:shadow-sm">
                <h2 class="text-lg font-semibold group-hover:text-[var(--color-primary)]">${esc(post.title)}</h2>
                ${post.excerpt ? `<p class="mt-1 text-sm text-[var(--color-text-secondary)] line-clamp-2">${esc(post.excerpt)}</p>` : ""}
                <div class="mt-2 text-xs text-[var(--color-text-tertiary)]">${new Date(post.published_at || post.created_at).toLocaleDateString("zh-CN")}</div>
              </a>
            `).join("")}</div>`;
        }
      } catch {
        if (requestId !== activeRequest) return;
        results.innerHTML = '<div class="py-8 text-center text-[var(--color-danger)]">搜索失败，请稍后重试</div>';
      }

      results.setAttribute("aria-busy", "false");
      btn.disabled = false;
      btn.textContent = "搜索";
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      doSearch(input.value);
    });

    // 快捷键 Ctrl/Cmd + K 聚焦搜索框
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        input.focus();
      }
    });
  </script>
</BaseLayout>
