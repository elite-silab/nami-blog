---
import BaseLayout from "@/layouts/BaseLayout.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8788";

interface Post {
  id: number;
  title: string;
  slug: string;
  excerpt: string | null;
  cover_url: string | null;
  is_pinned: number;
  published_at: string | null;
  created_at: string;
}

let posts: Post[] = [];
let categories: Array<{ id: number; name: string; slug: string; post_count: number }> = [];

try {
  const [postsRes, catsRes] = await Promise.all([
    fetch(`${apiUrl}/api/v1/posts?limit=10`),
    fetch(`${apiUrl}/api/v1/categories`),
  ]);
  if (postsRes.ok) posts = (await postsRes.json()).data || [];
  if (catsRes.ok) categories = (await catsRes.json()).data || [];
} catch {
  // 静态构建时 API 不可用仍能输出可访问的空状态页面。
}

const pinnedPosts = posts.filter((post) => post.is_pinned === 1);
const featuredPost = pinnedPosts[0] || posts[0] || null;
const feedPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 6);
const formatDate = (value: string | null) =>
  new Date(value || new Date().toISOString()).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<BaseLayout title="Nami Blog — 记录技术与生活" description="Nami Blog：在边缘计算上记录技术、生活与长期主义。">
  <div class="site-grid pointer-events-none absolute inset-x-0 top-0 h-[38rem] opacity-70"></div>

  <section class="relative mx-auto max-w-6xl px-4 pb-16 pt-8 sm:pt-16 lg:pb-24">
    <div class="grid items-end gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="max-w-2xl">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)]/80 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)] shadow-sm backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>
          Field notes from the edge
        </p>
        <h1 class="font-display text-5xl font-semibold leading-[0.98] tracking-[-0.04em] text-[var(--color-text)] sm:text-7xl">
          写给正在路上的<br /><span class="text-[var(--color-primary)]">技术与生活。</span>
        </h1>
        <p class="mt-7 max-w-xl text-base leading-8 text-[var(--color-text-secondary)] sm:text-lg">
          Nami 是一个运行在 Cloudflare 边缘网络上的个人博客。这里记录工程实践、阅读笔记，也保留那些值得慢慢想的片刻。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={featuredPost ? `/blog/${featuredPost.slug}` : "/blog"} class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)] px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-[var(--theme-glow)] transition hover:-translate-y-0.5 hover:bg-[var(--color-primary-hover)]">
            {featuredPost ? "阅读最新文章" : "浏览文章"} <span aria-hidden="true">↗</span>
          </a>
          <a href="/about" class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-bg)]/80 px-5 py-3 text-sm font-semibold text-[var(--color-text)] transition hover:-translate-y-0.5 hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]">
            认识 Nami <span aria-hidden="true">→</span>
          </a>
        </div>
        <dl class="mt-12 grid max-w-lg grid-cols-3 divide-x divide-[var(--color-border)] border-y border-[var(--color-border)] py-4">
          <div class="pr-4"><dt class="text-xs text-[var(--color-text-tertiary)]">已发布</dt><dd class="mt-1 font-display text-2xl font-semibold">{posts.length}</dd></div>
          <div class="px-4"><dt class="text-xs text-[var(--color-text-tertiary)]">分类</dt><dd class="mt-1 font-display text-2xl font-semibold">{categories.length}</dd></div>
          <div class="pl-4"><dt class="text-xs text-[var(--color-text-tertiary)]">部署</dt><dd class="mt-1 font-display text-2xl font-semibold">Edge</dd></div>
        </dl>
      </div>

      {featuredPost ? (
        <a href={`/blog/${featuredPost.slug}`} class="group relative overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-bg)] shadow-2xl shadow-[var(--theme-glow)] transition duration-500 hover:-translate-y-1 hover:shadow-[0_24px_70px_var(--theme-glow)]">
          <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-5 py-4 text-xs font-semibold text-white">
            <span class="rounded-full bg-black/25 px-3 py-1.5 backdrop-blur">📌 本期主角</span>
            <span class="rounded-full bg-black/25 px-3 py-1.5 backdrop-blur">{formatDate(featuredPost.published_at || featuredPost.created_at)}</span>
          </div>
          {featuredPost.cover_url ? (
            <img src={featuredPost.cover_url} alt="" class="h-72 w-full object-cover transition duration-700 group-hover:scale-105 sm:h-96" />
          ) : (
            <div class="theme-header h-72 sm:h-96"><div class="flex h-full items-end p-7"><span class="font-display text-8xl font-semibold text-[var(--color-primary)]/20">N</span></div></div>
          )}
          <div class="relative -mt-16 rounded-t-[1.5rem] bg-[var(--color-bg)] p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-primary)]">Featured note</p>
            <h2 class="mt-3 font-display text-3xl font-semibold leading-tight tracking-[-0.02em] group-hover:text-[var(--color-primary)] sm:text-4xl">{featuredPost.title}</h2>
            {featuredPost.excerpt && <p class="mt-3 line-clamp-2 text-sm leading-7 text-[var(--color-text-secondary)]">{featuredPost.excerpt}</p>}
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)]">打开文章 <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </div>
        </a>
      ) : (
        <div class="theme-header flex min-h-[25rem] items-end rounded-[2rem] border border-[var(--color-border)] p-8 shadow-xl shadow-[var(--theme-glow)]">
          <div><p class="text-sm font-semibold text-[var(--color-primary)]">还在准备中</p><h2 class="mt-2 font-display text-4xl font-semibold">下一篇故事，很快见。</h2></div>
        </div>
      )}
    </div>
  </section>

  <section id="latest" class="relative mx-auto max-w-6xl px-4 pb-20">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]">Latest dispatches</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-[-0.02em] sm:text-4xl">最近写了什么</h2>
      </div>
      <a href="/blog" class="text-sm font-semibold text-[var(--color-text-secondary)] transition hover:text-[var(--color-primary)]">查看全部文章 <span aria-hidden="true">↗</span></a>
    </div>

    {feedPosts.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2">
        {feedPosts.map((post, index) => (
          <a href={`/blog/${post.slug}`} class="group flex gap-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4 transition duration-300 hover:-translate-y-0.5 hover:border-[var(--color-primary)] hover:shadow-lg hover:shadow-[var(--theme-glow)]">
            <div class="flex h-24 w-24 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-[var(--color-bg-secondary)] sm:h-28 sm:w-28">
              {post.cover_url ? <img src={post.cover_url} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /> : <span class="font-display text-4xl text-[var(--color-primary)]/30">{String(index + 1).padStart(2, "0")}</span>}
            </div>
            <div class="min-w-0 py-1">
              <p class="text-xs text-[var(--color-text-tertiary)]">{formatDate(post.published_at || post.created_at)}</p>
              <h3 class="mt-2 line-clamp-2 font-display text-xl font-semibold leading-tight group-hover:text-[var(--color-primary)]">{post.title}</h3>
              {post.excerpt && <p class="mt-2 line-clamp-2 text-sm leading-6 text-[var(--color-text-secondary)]">{post.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-[var(--color-border-strong)] bg-[var(--color-bg-secondary)] p-10 text-center">
        <p class="font-display text-2xl">还没有公开文章</p>
        <p class="mt-2 text-sm text-[var(--color-text-secondary)]">发布第一篇文章后，它会出现在这里。</p>
      </div>
    )}

    {categories.length > 0 && (
      <div class="mt-14 border-t border-[var(--color-border)] pt-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class="mr-2 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-text-tertiary)]">Explore by topic</span>
          {categories.slice(0, 6).map((category) => (
            <a href={`/blog/category/${category.slug}`} class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-text-secondary)] transition hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]">
              {category.name} <span class="text-xs opacity-60">{category.post_count || 0}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
