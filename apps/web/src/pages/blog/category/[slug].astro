---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fetchBuildApi, handleBuildApiError } from "@/lib/build-api";

export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8788";
  let categories: Array<{ slug: string }> = [];
  try {
    const res = await fetchBuildApi(apiUrl, "/api/v1/categories");
    if (res.ok) {
      const json = await res.json();
      categories = json.data || [];
    }
  } catch (error) { handleBuildApiError("分类路径", error); }
  return categories.map((cat) => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8788";

interface Post {
  id: number;
  title: string;
  slug: string;
  excerpt: string | null;
  cover_url: string | null;
  published_at: string | null;
  created_at: string;
}

let posts: Post[] = [];
let categoryName = slug;

try {
  const [postsRes, catsRes] = await Promise.all([
    fetchBuildApi(apiUrl, `/api/v1/posts?category=${slug}&limit=100`),
    fetchBuildApi(apiUrl, "/api/v1/categories"),
  ]);
  if (postsRes.ok) {
    const json = await postsRes.json();
    posts = json.data || [];
  }
  if (catsRes.ok) {
    const json = await catsRes.json();
    const cat = (json.data || []).find((c: any) => c.slug === slug);
    if (cat) categoryName = cat.name;
  }
} catch (error) { handleBuildApiError(`分类 ${slug}`, error); }
---

<BaseLayout title={`分类：${categoryName} — Nami Blog`}>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-6 flex items-center gap-2">
      <a href="/" class="text-sm text-[var(--color-primary)] hover:underline">&larr; 返回首页</a>
    </div>
    <h1 class="text-2xl font-bold">📁 分类：{categoryName}</h1>
    <p class="mt-1 text-sm text-[var(--color-text-secondary)]">共 {posts.length} 篇文章</p>

    {posts.length === 0 ? (
      <div class="mt-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] py-12 text-center">
        <p class="text-[var(--color-text-secondary)]">该分类下暂无文章</p>
      </div>
    ) : (
      <div class="mt-6 space-y-4">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group block rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5 transition-all hover:border-[var(--color-primary)]">
            <h2 class="text-lg font-semibold group-hover:text-[var(--color-primary)]">{post.title}</h2>
            {post.excerpt && (
              <p class="mt-1 text-sm text-[var(--color-text-secondary)] line-clamp-2">{post.excerpt}</p>
            )}
            <div class="mt-2 text-xs text-[var(--color-text-tertiary)]">
              {new Date(post.published_at || post.created_at).toLocaleDateString("zh-CN")}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
