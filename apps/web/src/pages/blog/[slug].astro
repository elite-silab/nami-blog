---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommentSection from "@/components/CommentSection.astro";

export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8788";
  let posts: Array<{ slug: string }> = [];
  try {
    const res = await fetch(`${apiUrl}/api/v1/posts?limit=100`);
    if (res.ok) {
      const json = await res.json();
      posts = json.data || [];
    }
  } catch {
    // API 不可用时返回空路径
  }
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8788";

interface PostData {
  id: number;
  slug: string;
  title: string;
  content: string;
  content_html: string | null;
  excerpt: string | null;
  cover_url: string | null;
  view_count: number;
  word_count: number;
  published_at: string | null;
  created_at: string;
  updated_at: string;
  categories?: Array<{ id: number; name: string; slug: string }>;
  tags?: Array<{ id: number; name: string; slug: string; color: string }>;
  prev?: { id: number; title: string; slug: string } | null;
  next?: { id: number; title: string; slug: string } | null;
}

let post: PostData | null = null;

try {
  const res = await fetch(`${API_BASE}/api/v1/posts/${slug}`);
  if (res.ok) {
    const json = await res.json();
    post = json.data;
  }
} catch { /* ignore */ }

if (!post) {
  return new Response(null, { status: 404 });
}

const displayDate = post.published_at || post.created_at;
const siteUrl = import.meta.env.SITE_URL || "http://localhost:4321";
const postUrl = `${siteUrl}/blog/${post.slug}`;

const seoProps = {
  title: `${post.title} - Nami Blog`,
  description: post.excerpt || post.title,
  image: post.cover_url || undefined,
  type: "article",
  publishedAt: post.published_at || post.created_at,
};
---

<BaseLayout {...seoProps}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex gap-8">
      <!-- TOC 侧边栏（桌面端） -->
      <aside id="toc-sidebar" class="sticky top-20 hidden h-fit max-h-[calc(100vh-6rem)] w-56 flex-shrink-0 overflow-y-auto lg:block">
        <h3 class="mb-3 text-sm font-semibold text-[var(--color-text-secondary)]">目录</h3>
        <nav id="toc-nav" class="space-y-1 text-sm"></nav>
      </aside>

      <!-- 文章主体 -->
      <article class="prose mx-auto min-w-0 max-w-3xl flex-1">
        <header class="mb-8">
          <a href="/blog" class="mb-4 inline-block text-sm text-[var(--color-text-tertiary)] hover:text-[var(--color-primary)]">&larr; 返回列表</a>
          <h1 class="text-3xl font-bold">{post.title}</h1>
          <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-[var(--color-text-secondary)]">
            <time>{new Date(displayDate).toLocaleDateString("zh-CN")}</time>
            <span>·</span>
            <span>{post.word_count || "—"} 字</span>
            <span>·</span>
            <span>{post.view_count} 次阅读</span>
          </div>

          <!-- 分类和标签 -->
          <div class="mt-4 flex flex-wrap gap-2">
            {post.categories?.map((cat) => (
              <a href={`/blog/category/${cat.slug}`} class="rounded-full bg-[var(--color-bg-secondary)] px-3 py-1 text-xs text-[var(--color-text-secondary)] hover:text-[var(--color-primary)]">
                {cat.name}
              </a>
            ))}
            {post.tags?.map((tag) => (
              <a href={`/blog/tag/${tag.slug}`} class="rounded-full bg-[var(--color-bg-secondary)] px-3 py-1 text-xs text-[var(--color-text-secondary)] hover:text-[var(--color-primary)]">
                #{tag.name}
              </a>
            ))}
          </div>
        </header>

        {post.cover_url && (
          <img src={post.cover_url} alt={post.title} class="mb-8 aspect-video w-full rounded-xl object-cover" />
        )}

        <div id="post-content" class="prose" set:html={post.content_html || post.content} />

        <!-- 分享按钮 -->
        <div class="mt-8 flex items-center gap-3 border-t border-[var(--color-border)] pt-6">
          <span class="text-sm text-[var(--color-text-secondary)]">分享：</span>
          <button id="share-copy" class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-1.5 text-sm hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]">
            📋 复制链接
          </button>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.title)}`} target="_blank" rel="noopener"
            class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-1.5 text-sm hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]">
            𝕏 Twitter
          </a>
        </div>
      </article>
    </div>

    <!-- 上/下篇导航 -->
    {(post.prev || post.next) && (
      <nav class="mx-auto mt-8 grid max-w-3xl gap-4 sm:grid-cols-2">
        {post.prev ? (
          <a href={`/blog/${post.prev.slug}`} class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4 hover:border-[var(--color-primary)]">
            <div class="text-xs text-[var(--color-text-tertiary)]">&larr; 上一篇</div>
            <div class="mt-1 text-sm font-medium group-hover:text-[var(--color-primary)]">{post.prev.title}</div>
          </a>
        ) : <div />}
        {post.next ? (
          <a href={`/blog/${post.next.slug}`} class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4 text-right hover:border-[var(--color-primary)]">
            <div class="text-xs text-[var(--color-text-tertiary)]">下一篇 &rarr;</div>
            <div class="mt-1 text-sm font-medium group-hover:text-[var(--color-primary)]">{post.next.title}</div>
          </a>
        ) : <div />}
      </nav>
    )}
  </div>

  <CommentSection postId={post.id} />

  <script>
    // ── TOC 目录生成 ──
    const postContent = document.getElementById("post-content");
    const tocNav = document.getElementById("toc-nav");

    if (postContent && tocNav) {
      const headings = postContent.querySelectorAll("h2, h3");
      if (headings.length > 0) {
        const tocItems: Array<{ id: string; text: string; level: number }> = [];
        headings.forEach((h, i) => {
          const id = h.id || `heading-${i}`;
          if (!h.id) h.id = id;
          tocItems.push({ id, text: h.textContent || "", level: parseInt(h.tagName[1]) });
        });

        tocNav.innerHTML = tocItems.map((item) => {
          const indent = item.level === 3 ? "pl-4" : "";
          return `<a href="#${item.id}" class="toc-link block py-1 ${indent} text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors">${item.text}</a>`;
        }).join("");

        // 高亮当前 TOC 项
        const tocLinks = tocNav.querySelectorAll(".toc-link");
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                tocLinks.forEach((link) => link.classList.remove("text-[var(--color-primary)]", "font-medium"));
                const active = tocNav.querySelector(`a[href="#${entry.target.id}"]`);
                active?.classList.add("text-[var(--color-primary)]", "font-medium");
              }
            });
          },
          { rootMargin: "-20% 0px -80% 0px" },
        );
        headings.forEach((h) => observer.observe(h));
      } else {
        document.getElementById("toc-sidebar")?.classList.add("hidden");
      }
    }

    // ── 代码块复制按钮 ──
    document.querySelectorAll("#post-content pre code").forEach((codeBlock) => {
      const pre = codeBlock.parentElement;
      if (!pre) return;
      pre.style.position = "relative";

      const btn = document.createElement("button");
      btn.className = "absolute right-2 top-2 rounded-md bg-white/10 px-2 py-1 text-xs text-white opacity-0 transition-opacity hover:bg-white/20";
      btn.textContent = "复制";

      // 检测语言
      const langClass = Array.from(codeBlock.classList).find((c) => c.startsWith("language-"));
      if (langClass) {
        const langLabel = document.createElement("span");
        langLabel.className = "absolute left-2 top-2 rounded-md bg-white/10 px-2 py-1 text-xs text-white/60";
        langLabel.textContent = langClass.replace("language-", "");
        pre.appendChild(langLabel);
      }

      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(codeBlock.textContent || "");
          btn.textContent = "已复制 ✓";
          setTimeout(() => { btn.textContent = "复制"; }, 2000);
        } catch {
          btn.textContent = "失败";
        }
      });

      pre.addEventListener("mouseenter", () => { btn.style.opacity = "1"; });
      pre.addEventListener("mouseleave", () => { btn.style.opacity = "0"; });
      pre.appendChild(btn);
    });

    // ── 分享按钮 ──
    const shareBtn = document.getElementById("share-copy");
    shareBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        shareBtn.textContent = "✓ 已复制";
        setTimeout(() => { shareBtn.textContent = "📋 复制链接"; }, 2000);
      } catch {
        shareBtn.textContent = "复制失败";
      }
    });
  </script>
</BaseLayout>
